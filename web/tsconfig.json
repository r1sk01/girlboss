{
    "compilerOptions": {
        "jsx": "react-jsx",
        "allowJs": true,
        "moduleResolution": "bundler",
        "module": "Preserve",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["dist", "node_modules"]
}
